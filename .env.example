# Copy to .env and fill in. Docker Compose reads this file automatically.
#
# Nothing here is read by the service directly. The configuration file
# references these names with `!env`, and the service reads them from the
# environment at startup. A name that is referenced and missing makes the
# service refuse to start, which is deliberate: an empty credential is worse
# than a loud failure, because it looks like it worked.
#
# .env is in .gitignore and .dockerignore. Keep it that way.

# --------------------------------------------------------------------- core

# Seals credential values in the channel configuration stored in the database.
# Generate one with:
#
#   docker run --rm notifyrelay:dev --gen-key
#   # or, without Docker:
#   go run ./cmd/notifyrelay --gen-key
#
# Losing this key means losing every credential sealed with it. Back it up
# wherever the database is backed up, and somewhere else as well — a backup of
# the database without the key is a backup of ciphertext.
NOTIFYRELAY_SECRET_KEY=

# Signs operator UI sessions. Must be a different value from
# NOTIFYRELAY_SECRET_KEY: one key serving two purposes means a weakness in the
# weaker use is a weakness in both.
NOTIFYRELAY_SESSION_KEY=

# ------------------------------------------------------------------ channels

# Only the ones your channels actually use. An unset variable is fine while
# nothing references it; the moment the configuration does, startup fails.

SMTP_PASSWORD=
WECOM_CORP_SECRET=
DINGTALK_SECRET=
FEISHU_SECRET=
SLACK_TOKEN=
WEBHOOK_SECRET=

# ------------------------------------------------------- operator credentials
#
# The password hash and the username live in the configuration file, not here,
# because a hash is not a secret in the way a password is. Generate it with:
#
#   docker run --rm notifyrelay:dev --hash-password 'your-password'
#
# and put the result in admin.password_hash. There is no field for a plaintext
# password, by design.
