# Build output
/bin/
*.exe
*.test
*.out

# Local configuration (may contain secrets)
/configs/notifyrelay.yaml
.env

# Data (M4+)
/data/
*.db
*.db-journal
*.spool/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Built frontend. dist/ is produced by `npm run build` and embedded into the
# binary at compile time (web/embed.go); it is not source and is not committed.
# The placeholder stays so that //go:embed has something to match in a checkout
# where the frontend has never been built.
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/
